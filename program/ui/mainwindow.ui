  <property name="styleSheet">
   <string notr="true">
    /* Глобальный стиль космического интерфейса */
    QMainWindow {
        background-color: #0b0f19;
    }
    QWidget#centralwidget {
        background-color: #0b0f19;
    }
    
    /* Стилизация панелей групп (Сайдбары) */
    QGroupBox {
        font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;;
        font-size: 11px;
        font-weight: bold;
        color: #58a6ff;
        border: 1px solid #1f293d;
        border-radius: 6px;
        margin-top: 15px;
        padding-top: 10px;
        background-color: #0f1626;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        left: 10px;
        padding: 0 5px;
    }

    /* Метки */
    QLabel {
        color: #adbac7;
        font-family: &quot;Segoe UI&quot;;
        font-size: 11px;
    }

    /* Поля ввода чисел (SpinBox) */
    QDoubleSpinBox {
        background-color: #161d30;
        color: #ffffff;
        border: 1px solid #2d3d5a;
        border-radius: 4px;
        padding: 4px 6px;
        min-height: 20px;
    }
    QDoubleSpinBox:focus {
        border: 1px solid #58a6ff;
        background-color: #1b243c;
    }
    QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
        background: #1f293d;
        border-left: 1px solid #2d3d5a;
        width: 16px;
    }
    QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
        background: #283854;
    }

    /* Интерактивные кнопки */
    QPushButton {
        background-color: #1f293d;
        color: #58a6ff;
        border: 1px solid #384d75;
        border-radius: 4px;
        padding: 6px;
        font-family: &quot;Segoe UI&quot;;
        font-weight: bold;
        font-size: 11px;
    }
    QPushButton:hover {
        background-color: #283854;
        border: 1px solid #58a6ff;
        color: #ffffff;
    }
    QPushButton:pressed {
        background-color: #111827;
    }

    /* Кастомный стиль для опасных/акцентных действий (типа добавления/удаления) */
    QPushButton#button_addPlanet {
        background-color: #0e2a35;
        border: 1px solid #114b5f;
        color: #38bdf8;
    }
    QPushButton#button_addPlanet:hover {
        background-color: #114b5f;
        border: 1px solid #38bdf8;
        color: #ffffff;
    }
    QPushButton#button_removePlanet {
        background-color: #2a1414;
        border: 1px solid #632525;
        color: #f87171;
    }
    QPushButton#button_removePlanet:hover {
        background-color: #632525;
        border: 1px solid #f87171;
        color: #ffffff;
    }

    /* Область рендеринга КГ */
    QGraphicsView {
        background-color: #05070c;
        border: 2px solid #161f30;
        border-radius: 8px;
    }
   </string>
